<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_nav"
    app:startDestination="@id/recipesFragment">

    <fragment
        android:id="@+id/recipesFragment"
        android:name="com.example.myfoody.presentation.recipes.RecipesFragment"
        android:label="Recipes">
        <action
            android:id="@+id/action_recipesFragment_to_recipesBottomSheet"
            app:destination="@id/recipesBottomSheet" />
        <argument
            android:name="backFromBottomSheet"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_recipesFragment_to_detailsActivity"
            app:destination="@id/detailsActivity" />
    </fragment>
    <fragment
        android:id="@+id/favoriteRecipesFragment"
        android:name="com.example.myfoody.presentation.favorites.FavoriteRecipesFragment"
        android:label="Favorites">
        <action
            android:id="@+id/action_favoriteRecipesFragment_to_detailsActivity"
            app:destination="@id/detailsActivity" />
    </fragment>
    <fragment
        android:id="@+id/foodJokeFragment"
        android:name="com.example.myfoody.presentation.foodjoke.FoodJokeFragment"
        android:label="Food Joke"/>
    <dialog
        android:id="@+id/recipesBottomSheet"
        android:name="com.example.myfoody.presentation.recipes.filters.RecipesBottomSheet"
        android:label="recipes_bottom_sheet">
        <action
            android:id="@+id/action_recipesBottomSheet_to_recipesFragment"
            app:destination="@id/recipesFragment"
            app:popUpTo="@id/recipesFragment"
            app:popUpToInclusive="true" />
    </dialog>
    <activity
        android:id="@+id/detailsActivity"
        android:name="com.example.myfoody.presentation.details.DetailsActivity"
        android:label="Details">
        <argument
            android:name="result"
            app:argType="com.example.myfoody.presentation.navigation.RecipeParcelable" />
    </activity>
</navigation>